    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.2.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vue": "^3.5.42",
