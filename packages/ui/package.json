{
  "name": "@cladd-vue/ui",
  "version": "0.1.0",
  "description": "Vue 3 UI primitives for dense, accessible application interfaces, ported from Cladd.",
  "keywords": [
    "cladd",
    "design-system",
    "developer-tools",
    "native-ui",
    "tailwindcss",
    "ui-components",
    "vue"
  ],
  "homepage": "https://github.com/inventor7/cladd-vue#readme",
  "bugs": {
    "url": "https://github.com/inventor7/cladd-vue/issues"
  },
  "license": "MIT",
  "author": "Cladd Vue contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inventor7/cladd-vue.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/cladd.css",
    "./src/styles/**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./css": "./src/cladd.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.2.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
