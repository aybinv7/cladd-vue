{
  "name": "cladd-vue",
  "version": "0.1.5",
  "description": "Vue 3 UI primitives for dense, accessible application interfaces, ported from Cladd.",
  "keywords": [
    "cladd",
    "design-system",
    "developer-tools",
    "native-ui",
    "tailwindcss",
    "ui-components",
    "vue"
  ],
  "homepage": "https://github.com/aybinv7/cladd-vue#readme",
  "bugs": {
    "url": "https://github.com/aybinv7/cladd-vue/issues"
  },
  "license": "MIT",
  "author": "Cladd Vue contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/cladd-vue.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/cladd.css",
    "./src/styles/**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./calendar": {
      "source": "./src/calendar/index.ts",
      "types": "./dist/calendar/index.d.mts",
      "import": "./dist/calendar/index.mjs"
    },
    "./css": "./src/cladd.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.10.6",
    "tailwindcss": "4.2.2",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.2.0",
    "vite-plus": "0.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "tailwindcss": "^4.2.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
